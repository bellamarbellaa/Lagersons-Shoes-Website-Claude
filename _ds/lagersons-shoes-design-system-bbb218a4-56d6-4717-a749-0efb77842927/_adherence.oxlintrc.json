{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/layout/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|Inter Tight|Poppins|Open Sans))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, Inter Tight, Poppins, Open Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|block|disabled|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, block, disabled, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|whatsapp|onbrand|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'whatsapp' | 'onbrand' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm|wp)$/]",
        "message": "<Button> size must be one of 'md' | 'sm' | 'wp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: icon, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|title|children|actionLabel|href|variant|key|ref|className|style|children)$/]",
        "message": "<ContactTile> doesn't accept that prop. Declared props: glyph, title, children, actionLabel, href, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactTile'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|whatsapp)$/]",
        "message": "<ContactTile> variant must be one of 'primary' | 'outline' | 'whatsapp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|actions|key|ref|className|style|children)$/]",
        "message": "<CtaBand> doesn't accept that prop. Declared props: title, children, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|pink|olive)$/]",
        "message": "<Eyebrow> tone must be one of 'gold' | 'pink' | 'olive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|alt|reverse|children|key|ref|className|style|children)$/]",
        "message": "<FeatureRow> doesn't accept that prop. Declared props: image, alt, reverse, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuestFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|media|layout|key|ref|className|style|children)$/]",
        "message": "<GuestFrame> doesn't accept that prop. Declared props: name, role, media, layout."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuestFrame'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:row|stack)$/]",
        "message": "<GuestFrame> layout must be one of 'row' | 'stack'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|level|align|children|key|ref|className|style|children)$/]",
        "message": "<InfoCard> doesn't accept that prop. Declared props: title, level, align, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoCard'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:h3|h4|h5)$/]",
        "message": "<InfoCard> level must be one of 'h3' | 'h4' | 'h5'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoCard'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<InfoCard> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|title|children|key|ref|className|style|children)$/]",
        "message": "<PageHero> doesn't accept that prop. Declared props: tag, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<PillTag> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:tint|solid|outline)$/]",
        "message": "<PillTag> tone must be one of 'tint' | 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|alt|tag|title|children|price|shopeeHref|whatsappHref|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: image, alt, tag, title, children, price, shopeeHref, whatsappHref."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|alt|href|caption|key|ref|className|style|children)$/]",
        "message": "<PromoBanner> doesn't accept that prop. Declared props: image, alt, href, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|eyebrowTone|title|children|divider|align|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: eyebrow, eyebrowTone, title, children, divider, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='eyebrowTone'] > Literal[value!=/^(?:gold|pink|olive)$/]",
        "message": "<SectionHead> eyebrowTone must be one of 'gold' | 'pink' | 'olive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionHead> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:onNavigate|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|items|onNavigate|contactHref|logoSrc|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: active, items, onNavigate, contactHref, logoSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|icon|children|key|ref|className|style|children)$/]",
        "message": "<SocialPill> doesn't accept that prop. Declared props: href, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|address|hours|mapHref|whatsappHref|key|ref|className|style|children)$/]",
        "message": "<StoreCard> doesn't accept that prop. Declared props: name, address, hours, mapHref, whatsappHref."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|initial|children|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: name, role, initial, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppFloat'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|key|ref|className|style|children)$/]",
        "message": "<WhatsAppFloat> doesn't accept that prop. Declared props: href."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
